rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  	//Projeler
  	match /projects/{projectId} {
      allow read: if true;
      allow write, update, delete: if request.auth != null;
    }
    
  	match /posts/{postId} {
      // "isPublished" alanı true olan yazıları herkes okuyabilir.
      allow read: if resource.data.isPublished == true;
      // Adminler tüm yazıları okuyabilir (taslaklar dahil).
      allow read: if request.auth != null;
      // Sadece adminler yazı yazabilir, güncelleyebilir, silebilir.
      allow write, update, delete: if request.auth != null;
    }
    
    // Admin listesi (değişiklik yok)
    match /admins/{email} {
      allow read, write: if request.auth != null && request.auth.token.email in get(/databases/$(database)/documents/admins).keys();
    }
    
    // Linkler (değişiklik yok)
     match /links/{linkId} {
      allow read, create: if true;
      // GÜNCELLEME KURALI:
      // Sadece adminler her şeyi güncelleyebilir.
      allow update: if request.auth != null;
      // Herkes, sadece 'clicks' alanını artıracak şekilde güncelleme yapabilir.
      allow update: if request.resource.data.keys().hasOnly(['slug', 'longUrl', 'createdAt', 'clicks']) &&
                      request.resource.data.clicks == resource.data.clicks + 1;
      
      allow delete: if request.auth != null;
    }
    // YENİ KURAL: config koleksiyonunu sadece adminler okuyup yazabilir.
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // İhtiyaç listesi koleksiyonları 
    match /{collection}/{itemId} {
      allow read: if true;
      allow write, update, delete: if request.auth != null;
    }
    // Timeline listesi koleksiyonları
    match /timeline/{eventId} {
      allow read: if true;
      allow write, update, delete: if request.auth != null;
    }
    
      
  }
}